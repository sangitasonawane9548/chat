# =============================================================================
# Aether Platform - Backend Environment Configuration (.env.example)
# =============================================================================

# Server Port & Execution Mode
PORT=5000
NODE_ENV=production

# Email OTP Mode: 'demo' (fixed OTP 123456 for local QA) or 'production' (cryptographic random OTP via SMTP)
OTP_MODE=production

# Allowed Frontend URL for CORS & Socket.IO
FRONTEND_URL=https://chat.example.com

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aether_db_user
DB_PASSWORD=aether_secure_password_replace_me
DB_NAME=username_chat_platform

# Cryptographic Secrets
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_minimum_32_characters
COOKIE_SECRET=replace_with_a_long_random_cookie_signing_secret_minimum_32_characters
JWT_EXPIRES_IN=7d

# SMTP Email Configuration (Required in Production for OTP and Password Reset)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=replace_with_sendgrid_or_smtp_password
EMAIL_FROM="Aether Platform" <no-reply@chat.example.com>

# WebRTC STUN / TURN Relay Servers (Required for NAT / Firewall traversal)
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
WEBRTC_TURN_SERVER=turn:turn.example.com:3478
WEBRTC_TURN_USERNAME=aether_turn_user
WEBRTC_TURN_CREDENTIAL=aether_turn_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
