# =============================================================================
# MELT 2.0 Real-Time Chat & Calling Platform - Backend Environment Template
# =============================================================================

# Server Environment & Port (Render automatically sets PORT in production)
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# Frontend Deployment URLs (Comma-separated for multiple origins, e.g. Vercel preview & production)
FRONTEND_URL=https://your-melt-app.vercel.app,https://your-custom-domain.com

# -----------------------------------------------------------------------------
# Aiven MySQL Database Connection
# -----------------------------------------------------------------------------
# Option A: Connection URI provided by Aiven Service URI
# DATABASE_URL=mysql://avnadmin:your_password@mysql-xxxxx-project.aivencloud.com:port/defaultdb?ssl-mode=REQUIRED

# Option B: Individual Connection Parameters
DB_HOST=mysql-xxxxx-project.aivencloud.com
DB_PORT=25060
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb

# SSL Configuration for Aiven Cloud
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
# Optional: Provide raw CA certificate PEM or local path if verifying CA:
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Database Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=20000

# -----------------------------------------------------------------------------
# Authentication & Cryptographic Secrets
# -----------------------------------------------------------------------------
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=melt_production_jwt_secret_generate_random_64_characters
COOKIE_SECRET=melt_production_cookie_secret_generate_random_64_characters
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# OTP & Email Delivery Configuration
# -----------------------------------------------------------------------------
# Set to 'production' for live email OTP delivery via SMTP.
# Set to 'demo' for dev/testing (accepts 123456 as universal OTP).
OTP_MODE=production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_verified_sender@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM="MELT" <no-reply@yourdomain.com>

# -----------------------------------------------------------------------------
# WebRTC Audio & Video Calling (STUN / TURN Relays)
# -----------------------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302
# Optional TURN server for symmetric NATs / strict firewalls (e.g. Metered.ca, Xirsys, Coturn)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# -----------------------------------------------------------------------------
# Persistent Cloud Media Storage (Cloudinary)
# -----------------------------------------------------------------------------
# Render disk is ephemeral; configure Cloudinary for persistent media storage
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# -----------------------------------------------------------------------------
# Rate Limiting & Protection
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
