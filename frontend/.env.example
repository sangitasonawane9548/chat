# Production Backend API URL (Point to your deployed Render web service)
# Example: https://melt-chat-backend.onrender.com
VITE_API_URL=https://melt-chat-backend.onrender.com

# Optional: Dedicated Socket.IO URL (Defaults to VITE_API_URL if omitted)
# VITE_SOCKET_URL=https://melt-chat-backend.onrender.com

# Optional: Custom STUN / TURN relays for WebRTC
# VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# VITE_TURN_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
